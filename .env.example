# Copy to .env.local for local dev. On the host (e.g. Vercel), set these as
# environment variables for the build. All VITE_* values end up in the public
# JS bundle, so never put secrets here.

# Base URL of the RackUp API (rackUp-api), no trailing slash.
VITE_API_URL=http://localhost:8080

# Path of the hidden login page. Not linked anywhere in the UI.
# Must start with "/". Default: /login-secret
VITE_LOGIN_PATH=/login-secret
